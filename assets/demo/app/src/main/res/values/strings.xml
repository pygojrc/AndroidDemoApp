    <string name="components_menu_second">示例操作二</string>
    <string name="components_snackbar_message">这是一个不会遮挡底部导航的 Snackbar。</string>
    <string name="components_dialog_title">Material 3 对话框</string>
    <string name="components_dialog_description">对话框状态由当前页面持有，关闭后不会影响导航返回栈。</string>
    <string name="components_bottom_sheet_title">Material 3 底部弹层</string>
    <string name="components_bottom_sheet_description">底部弹层由根界面显示，并为系统导航区域保留安全空间。</string>
    <string name="components_floating_title">应用内悬浮组件</string>
    <string name="components_floating_description">右下角 FAB 可展开快捷操作；悬浮框只能在当前页面的安全内容区域内拖动，不需要悬浮窗权限。</string>
