    <string name="drawer_subtitle">Android 13+ Compose Demo</string>
    <string name="about_title">关于 Demo</string>
    <string name="about_description">这是 android-modern-app Skill 使用的最小可编译模板，集中演示导航、Insets、主题和常用 Material 3 组件。</string>

    <string name="home_welcome">现代 Android，从可靠模板开始</string>
    <string name="home_description">这个 Demo 展示 Android 13+ Compose 应用的基础结构，并把系统栏、底部导航和键盘遮挡处理放在统一边界内。</string>
    <string name="feature_insets_title">Edge-to-edge 与 Insets</string>
    <string name="feature_insets_description">顶部栏、页面内容、底部导航和软键盘各自处理明确的安全区域，避免重复 padding。</string>
    <string name="feature_navigation_title">Compose-first Navigation 3</string>
    <string name="feature_navigation_description">返回栈由应用持有，底部导航和左侧抽屉共享同一套一级页面状态。</string>
    <string name="feature_theme_title">Material 3 主题</string>
    <string name="feature_theme_description">默认跟随系统深色模式并启用动态配色，同时提供完整回退色板。</string>

    <string name="input_description">点击输入框弹出软键盘，滚动内容和主要操作按钮应保持可见。</string>
    <string name="input_title_label">标题</string>
    <string name="input_content_label">正文</string>

    <string name="components_heading">常用 Compose 组件</string>
    <string name="components_description">这里集中展示反馈、弹层、表单和应用内悬浮组件，不引入第三方 UI 依赖。</string>
